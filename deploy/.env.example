# ---------------------------------------------------------------------------
#  NautilusTrader Local Deployment Environment
#  Copy to .env and fill in your values
# ---------------------------------------------------------------------------

# ── Trading Node ───────────────────────────────────────────────────────────
NAUTILUS_TRADER_ID=TRADER-001
NAUTILUS_ENVIRONMENT=sandbox

# ── API Server ─────────────────────────────────────────────────────────────
# Leave blank to disable API key authentication (local dev only)
NAUTILUS_API_KEY=
API_PORT=8001

# ── MCP Server ─────────────────────────────────────────────────────────────
MCP_SAFETY_LEVEL=STANDARD
MCP_PORT=8002

# ── Infrastructure ─────────────────────────────────────────────────────────
REDIS_PORT=6379
POSTGRES_USER=nautilus
POSTGRES_PASSWORD=pass
POSTGRES_DB=nautilus
POSTGRES_PORT=5432

# ── Exchange API Keys (add yours) ─────────────────────────────────────────
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
# BINANCE_TESTNET=true

# ── AI Agent (optional) ───────────────────────────────────────────────────
# ANTHROPIC_API_KEY=
